{
  "manifest_version": 3,
  "name": "Christian's Gmail Enhancements",
  "version": "1.0.0",
  "description": "Small fixes for Gmail. Links in emails go straight where they point, without Google's redirect page.",
  "minimum_chrome_version": "126",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
